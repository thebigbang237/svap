NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
# Verified Resend sender address. Falls back to onboarding@resend.dev
# (Resend's shared test sender) if unset — fine for local dev, not for
# production sends to real applicants.
RESEND_FROM_EMAIL=
# Absolute site URL. Drives metadataBase and hreflang, the admin notification
# email's link to the candidature, and the Phase-2 portal deep link in the
# access-code email. Falls back to http://localhost:3000 if unset.
#
#   local:      http://localhost:3000
#   staging:    https://svap-zeta.vercel.app
#   production: https://siliconvalleyafricaprogram.com
#
# Must match the host registered with pawaPay and Stripe — a mismatch means
# callbacks arrive at a URL that isn't this deployment.
NEXT_PUBLIC_SITE_URL=

# --- Phase 2 access codes -------------------------------------------------
# Server-side pepper for HMAC-hashing access codes. The codes themselves are
# short enough to enumerate offline, so this is what makes a leaked
# access_codes table useless to an attacker. Generate with:
#   openssl rand -hex 32
# Rotating it invalidates every outstanding code — candidates mid-Phase-2
# would have to request a new one, so treat it as permanent per environment.
ACCESS_CODE_PEPPER=

# Signing key for the Phase-2 session cookie issued when a code is redeemed.
# Generate with: openssl rand -hex 32
# Rotating it signs everyone out; they re-enter with name + code.
PHASE2_SESSION_SECRET=

# Bearer token the access-code cron endpoint requires
# (POST /api/cron/access-codes). Without it the route returns 404 to
# everyone, so codes are never sent. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Phase 2 dossier ------------------------------------------------------
# AES-256-GCM key sealing individual high-sensitivity fields (currently the
# passport number). Must be exactly 32 bytes as hex:
#   openssl rand -hex 32
# LOSING THIS KEY MAKES EXISTING PASSPORT NUMBERS UNRECOVERABLE — back it up
# somewhere separate from the database. Rotating it needs a re-encryption
# pass over svap.phase2_applications; the `v1.` prefix on each ciphertext is
# what makes that migration possible.
FIELD_ENCRYPTION_KEY=

# --- Payments -------------------------------------------------------------
# pawaPay — mobile money for Cameroun, Kenya and Ghana ONLY. It does not
# cover Morocco, Egypt or South Africa, which is why Stripe below is
# mandatory rather than optional.
# PAWAPAY_ENV: "sandbox" (default) or "live".
PAWAPAY_ENV=sandbox
PAWAPAY_API_TOKEN=
# HMAC-SHA256 secret for callback signatures. Without it every pawaPay
# callback is REJECTED — the endpoint fails closed rather than trusting
# unsigned notifications that could mark any dossier as paid.
PAWAPAY_WEBHOOK_SECRET=

# Stripe — cards in all six countries, settling USD to the US entity.
# Use sk_test_… while building; the webhook secret comes from
#   stripe listen --forward-to localhost:3000/api/payments/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# USD → local currency rates as JSON, used only for mobile money (card
# payments settle in USD and need no conversion).
#
# ⚠️ MANUAL AND WILL GO STALE. XAF is pegged to EUR so it drifts with
# EUR/USD; KES, GHS, ZAR and EGP float freely. A stale table means either
# under-charging or over-charging a candidate. Replace with a rate feed
# before production — the rate actually used is locked onto each payment row,
# so receipts stay correct whatever the source becomes.
FX_RATES_USD={"XAF":610.5,"KES":129.2,"GHS":15.1,"ZAR":18.2,"MAD":9.9,"EGP":48.5}
